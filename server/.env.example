# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Put the database name before the "?".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/neon-food?retryWrites=true&w=majority

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Where the React app runs (Vite's default locally; your Vercel URL in production)
CLIENT_URL=http://localhost:5173

# lax (default) works when the front end proxies /api. Use none only for cross-site cookies.
COOKIE_SAMESITE=lax

# Optional: how the app identifies itself to OpenStreetMap's address lookup service
GEOCODER_USER_AGENT=NeonFoodDelivery/1.0 (student project, Dublin Business School)

# Stripe TEST keys only (starting sk_test_), from dashboard.stripe.com > Developers > API keys
STRIPE_SECRET_KEY=
# Signing secret (starting whsec_) of the webhook you create in Stripe for /api/payments/webhook
STRIPE_WEBHOOK_SECRET=
